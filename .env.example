# Optional locally; REQUIRED for Vercel. Connect Upstash Redis from Vercel Storage.
# Both Upstash's UPSTASH_REDIS_REST_* and Vercel's KV_REST_API_* names work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

